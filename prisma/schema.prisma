// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id             Int     @id @default(autoincrement())
  slug           String  @unique
  title          String
  subtitle       String?
  imagePath      String?
  imagePublicId  String?
  dimensionLabel String  @default("Medida")
  order          Int     @default(0)

  products Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code          String
  description   String
  dimension     String
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  order         Int      @default(0)
  imageUrl      String?
  imagePublicId String?

  movements          StockMovement[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([categoryId])
  @@map("products")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  movements          StockMovement[]
  salesOrders        SalesOrder[]
  purchaseOrders     PurchaseOrder[]
  salesOrderPayments SalesOrderPayment[]
  sellerPayments     SellerPayment[]
  purchasePayments   PurchaseOrderPayment[]
  operatingExpenses  OperatingExpense[]
  campaigns          Campaign[]
  /// ADMIN (todo el panel) o VENDEDOR (solo catálogo y sus órdenes de venta)
  role               String              @default("ADMIN")
  sellerId           Int?                @unique
  seller             Seller?             @relation(fields: [sellerId], references: [id])

  @@map("users")
}

/// Cliente al que se le puede vender de contado o a crédito
model Customer {
  id              Int       @id @default(autoincrement())
  /// Nombre de contacto
  name            String
  company         String?
  /// RIF o cédula, para la orden de entrega y la factura
  taxId           String?
  phone           String?
  email           String?
  address         String?
  notes           String?
  /// Baja lógica: los clientes no se borran, solo se cancelan
  cancelledAt     DateTime?
  /// true si pidió no recibir promociones por correo (enlace de baja)
  marketingOptOut Boolean   @default(false)
  createdAt       DateTime  @default(now())

  salesOrders SalesOrder[]

  @@map("customers")
}

/// Vendedor con comisión. Una orden sin vendedor es venta de tienda (sin comisión).
model Seller {
  id                Int       @id @default(autoincrement())
  name              String
  phone             String?
  commissionPercent Decimal   @default(0) @db.Decimal(5, 2)
  /// Baja lógica: los vendedores no se borran, solo se cancelan
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())

  salesOrders SalesOrder[]
  user        User?
  payments    SellerPayment[]

  @@map("sellers")
}

/// Pago hecho a un vendedor por su comisión de un mes (periodYear/periodMonth, hora de Caracas)
model SellerPayment {
  id          Int      @id @default(autoincrement())
  sellerId    Int
  seller      Seller   @relation(fields: [sellerId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  periodYear  Int
  periodMonth Int
  notes       String?
  createdAt   DateTime @default(now())

  @@index([sellerId, periodYear, periodMonth])
  @@map("seller_payments")
}

/// Promoción enviada por correo a clientes (historial de envíos masivos)
model Campaign {
  id         Int      @id @default(autoincrement())
  subject    String
  highlight  String?
  body       String   @db.Text
  audience   String
  recipients Int
  sent       Int
  failed     Int
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("campaigns")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  delta     Int
  reason    String   @default("AJUSTE")
  createdAt DateTime @default(now())

  salesOrderItemId    Int?
  salesOrderItem      SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id])
  purchaseOrderItemId Int?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([salesOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("stock_movements")
}

/// Orden de venta (reemplaza la hoja impresa: cliente, fecha/hora y líneas de trabajo)
model SalesOrder {
  id                    Int       @id @default(autoincrement())
  customerName          String
  customerId            Int?
  customer              Customer? @relation(fields: [customerId], references: [id])
  sellerId              Int?
  seller                Seller?   @relation(fields: [sellerId], references: [id])
  /// % de comisión congelado al crear la orden (no cambia si luego se edita el vendedor)
  commissionPercent     Decimal?  @db.Decimal(5, 2)
  /// Cuándo se mandó el recordatorio de cobranza (crédito con saldo); null = aún no
  collectionEmailSentAt DateTime?
  /// Orden de entrega (documento interno para el transportista)
  driverName            String?
  driverIdNumber        String?
  vehiclePlate          String?
  /// N° de control que asigna la imprenta digital autorizada (se registra a mano)
  deliveryControlNumber String?
  deliveryPrinterInfo   String?
  deliveryAddress       String?
  notes                 String?
  status                String    @default("CONFIRMADA")
  paymentType           String    @default("CONTADO")
  /// Plazo de crédito que se ofreció (7, 15 o 30 días); solo en órdenes a crédito
  creditDays            Int?
  /// TIENDA = recogido en tienda, DESPACHADO = lo llevamos al cliente en transporte propio
  deliveryType          String    @default("TIENDA")
  userId                Int
  user                  User      @relation(fields: [userId], references: [id])
  createdAt             DateTime  @default(now())

  items    SalesOrderItem[]
  payments SalesOrderPayment[]

  @@index([userId])
  @@index([customerId])
  @@index([sellerId])
  @@map("sales_orders")
}

/// Abono / pago recibido contra una orden de venta a crédito
model SalesOrderPayment {
  id        Int        @id @default(autoincrement())
  orderId   Int
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal    @db.Decimal(10, 2)
  notes     String?
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@index([orderId])
  @@map("sales_order_payments")
}

model SalesOrderItem {
  id       Int        @id @default(autoincrement())
  orderId  Int
  order    SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int        @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  description     String
  quantity        Int
  unitPrice       Decimal? @db.Decimal(10, 2)
  /// Descuento en porcentaje (0-100) aplicado a esta línea
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)

  movements StockMovement[]

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_items")
}

/// Orden de compra / reposición de inventario
model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  supplierName String
  notes        String?
  status       String    @default("PENDIENTE")
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  receivedAt   DateTime?

  items    PurchaseOrderItem[]
  expenses PurchaseOrderExpense[]
  payments PurchaseOrderPayment[]

  @@index([userId])
  @@map("purchase_orders")
}

/// Pago (abono) hecho al proveedor / por los gastos de una orden de compra, en dólares.
/// Lo que se debe = costo total de la orden (factura + gastos) menos la suma de sus pagos.
model PurchaseOrderPayment {
  id        Int           @id @default(autoincrement())
  orderId   Int
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(10, 2)
  /// Fecha en que se hizo el pago (puede ser anterior al registro)
  paidAt    DateTime      @default(now())
  notes     String?
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
  /// Un pago nunca se borra: se anula y queda la huella (cuándo, quién y por qué).
  /// Los pagos anulados no cuentan en el saldo.
  voidedAt     DateTime?
  voidedById   Int?
  voidedByName String?
  voidReason   String?

  @@index([orderId])
  @@map("purchase_order_payments")
}

/// Gasto propio de un contenedor / orden de compra (flete, aduana, transporte...), en dólares.
/// Se reparte entre los productos de la orden en proporción a su costo de factura.
model PurchaseOrderExpense {
  id        Int           @id @default(autoincrement())
  orderId   Int
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  concept   String
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  /// Un gasto nunca se borra: se anula y queda la huella (cuándo, quién y por qué).
  /// Los gastos anulados no cuentan en el costo de la orden.
  voidedAt     DateTime?
  voidedById   Int?
  voidedByName String?
  voidReason   String?

  @@index([orderId])
  @@map("purchase_order_expenses")
}

/// Gasto operativo del negocio (empleados, transporte de despachos, servicios...), en dólares.
model OperatingExpense {
  id          Int      @id @default(autoincrement())
  expenseDate DateTime
  category    String
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([expenseDate])
  @@map("operating_expenses")
}

model PurchaseOrderItem {
  id        Int           @id @default(autoincrement())
  orderId   Int
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Int
  cost      Decimal?      @db.Decimal(10, 2)

  movements StockMovement[]

  @@index([orderId])
  @@index([productId])
  @@map("purchase_order_items")
}
