// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id             Int     @id @default(autoincrement())
  slug           String  @unique
  title          String
  subtitle       String?
  imagePath      String?
  imagePublicId  String?
  dimensionLabel String  @default("Medida")
  order          Int     @default(0)

  products Product[]

  @@map("categories")
}

model Product {
  id             Int      @id @default(autoincrement())
  categoryId     Int
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code           String
  description    String
  dimension      String
  price          Decimal  @db.Decimal(10, 2)
  suggestedPrice Decimal? @db.Decimal(10, 2)
  stock          Int      @default(0)
  order          Int      @default(0)
  imageUrl       String?
  imagePublicId  String?

  movements          StockMovement[]
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([categoryId])
  @@map("products")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  movements          StockMovement[]
  salesOrders        SalesOrder[]
  purchaseOrders     PurchaseOrder[]
  salesOrderPayments SalesOrderPayment[]

  @@map("users")
}

/// Cliente al que se le puede vender de contado o a crédito
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  salesOrders SalesOrder[]

  @@map("customers")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  delta     Int
  reason    String   @default("AJUSTE")
  createdAt DateTime @default(now())

  salesOrderItemId    Int?
  salesOrderItem      SalesOrderItem?    @relation(fields: [salesOrderItemId], references: [id])
  purchaseOrderItemId Int?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([salesOrderItemId])
  @@index([purchaseOrderItemId])
  @@map("stock_movements")
}

/// Orden de venta (reemplaza la hoja impresa: cliente, fecha/hora, plotter y líneas de trabajo)
model SalesOrder {
  id           Int       @id @default(autoincrement())
  customerName String
  customerId   Int?
  customer     Customer? @relation(fields: [customerId], references: [id])
  plotter      String?
  notes        String?
  status       String    @default("CONFIRMADA")
  paymentType  String    @default("CONTADO")
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())

  items    SalesOrderItem[]
  payments SalesOrderPayment[]

  @@index([userId])
  @@index([customerId])
  @@map("sales_orders")
}

/// Abono / pago recibido contra una orden de venta a crédito
model SalesOrderPayment {
  id        Int        @id @default(autoincrement())
  orderId   Int
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal    @db.Decimal(10, 2)
  notes     String?
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@index([orderId])
  @@map("sales_order_payments")
}

model SalesOrderItem {
  id       Int        @id @default(autoincrement())
  orderId  Int
  order    SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int        @default(0)

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  material    String?
  tipo        String?
  reverso     String?
  acabado     String?
  ancho       Decimal? @db.Decimal(10, 2)
  alto        Decimal? @db.Decimal(10, 2)
  m2          Decimal? @db.Decimal(10, 2)
  description String
  quantity    Int
  unitPrice   Decimal? @db.Decimal(10, 2)

  movements StockMovement[]

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_items")
}

/// Orden de compra / reposición de inventario
model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  supplierName String
  notes        String?
  status       String    @default("PENDIENTE")
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  receivedAt   DateTime?

  items PurchaseOrderItem[]

  @@index([userId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id             Int           @id @default(autoincrement())
  orderId        Int
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product       @relation(fields: [productId], references: [id])
  quantity       Int
  cost           Decimal?      @db.Decimal(10, 2)
  suggestedPrice Decimal?      @db.Decimal(10, 2)

  movements StockMovement[]

  @@index([orderId])
  @@index([productId])
  @@map("purchase_order_items")
}
