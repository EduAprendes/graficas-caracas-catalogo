// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Category {
  id             Int     @id @default(autoincrement())
  slug           String  @unique
  title          String
  subtitle       String?
  imagePath      String?
  imagePublicId  String?
  dimensionLabel String  @default("Medida")
  order          Int     @default(0)

  products Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code          String
  description   String
  dimension     String
  price         Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  order         Int      @default(0)
  imageUrl      String?
  imagePublicId String?

  movements StockMovement[]

  @@index([categoryId])
  @@map("products")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  movements StockMovement[]

  @@map("users")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  delta     Int
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@map("stock_movements")
}
